@model RaceDay.MVC.Models.EventListVm
@{
    ViewData["Title"] = "Upcoming events";
}

<h1 class="mb-3">Upcoming events</h1>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-5">
        <input name="search" value="@Model.Search" class="form-control"
               placeholder="Search by event name or location" />
    </div>
    <div class="col-md-3">
        <select name="type" class="form-select">
            <option value="">All types</option>
            @foreach (var t in new[] { "Run", "Walk", "Cycle" })
            {
                <option value="@t" selected="@(Model.Type == t)">@t</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <button type="submit" class="btn btn-raceday">Filter</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

@if (!Model.Events.Any())
{
    <div class="alert alert-info">No upcoming events match your search.</div>
}

<div class="row g-4">
    @foreach (var e in Model.Events)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100">
                <partial name="_EventBanner" model="e" />
                <div class="card-body">
                    <h5 class="card-title">@e.EventName</h5>
                    <p class="text-muted mb-1">📍 @e.Location</p>
                    <p class="mb-0">📅 @e.EventDate.ToString("dd MMM yyyy") · @e.DistanceKM.ToString("0.##") km</p>
                </div>
                <div class="card-footer bg-white border-0">
                    <a asp-action="Details" asp-route-id="@e.EventID" class="btn btn-raceday w-100">View details</a>
                </div>
            </div>
        </div>
    }
</div>
