@model RaceDay.MVC.Models.CategoryFormVm
@{
    ViewData["Title"] = "Edit category";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <h1 class="mb-4">Edit category</h1>

        <form asp-action="EditCategory" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="CategoryID" />
            <input type="hidden" asp-for="EventID" />

            <div class="mb-3">
                <label asp-for="CategoryName" class="form-label"></label>
                <input asp-for="CategoryName" class="form-control" />
                <span asp-validation-for="CategoryName" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="DistanceKM" class="form-label"></label>
                    <input asp-for="DistanceKM" type="number" step="0.1" min="0.1" class="form-control" />
                    <span asp-validation-for="DistanceKM" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="EntryFee" class="form-label"></label>
                    <input asp-for="EntryFee" type="number" step="0.01" min="0" class="form-control" />
                    <span asp-validation-for="EntryFee" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="AgeGroup" class="form-label"></label>
                <input asp-for="AgeGroup" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <input asp-for="Description" class="form-control" />
            </div>

            <button type="submit" class="btn btn-raceday">Save changes</button>
            <a asp-action="Categories" asp-route-eventId="@Model.EventID" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}