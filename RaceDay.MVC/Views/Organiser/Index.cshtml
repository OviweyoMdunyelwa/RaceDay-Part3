@model RaceDay.MVC.Models.OrganiserDashboardVm
@{
    ViewData["Title"] = "Dashboard";
}

@functions {
    static string Badge(string? s) => (s ?? "").ToLowerInvariant() switch
    {
        "paid" or "confirmed" => "status-confirmed",
        "pending" => "status-pending",
        _ => "status-cancelled"
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Organiser dashboard</h1>
    <a asp-action="CreateEvent" class="btn btn-accent">+ New event</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card h-100 text-center p-3">
            <div class="display-6">@Model.TotalEvents</div>
            <div class="text-muted">My events</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100 text-center p-3">
            <div class="display-6">@Model.UpcomingEvents</div>
            <div class="text-muted">Upcoming events</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100 text-center p-3">
            <div class="display-6">@Model.TotalEnrolments</div>
            <div class="text-muted">Total enrolments</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100 text-center p-3">
            <div class="display-6">@Model.PendingEnrolments</div>
            <div class="text-muted">Pending enrolments</div>
        </div>
    </div>
</div>

<h2 class="h4">Upcoming events</h2>
@if (!Model.Upcoming.Any())
{
    <div class="alert alert-info">
        You have no upcoming events. <a asp-action="CreateEvent">Create one now</a>.
    </div>
}
else
{
    <div class="table-responsive mb-4">
        <table class="table table-hover align-middle bg-white">
            <thead class="table-light">
                <tr><th>Event</th><th>Date</th><th>When</th><th>Enrolments</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Upcoming)
                {
                    <tr>
                        <td>@row.Event.EventName</td>
                        <td>@row.Event.EventDate.ToString("dd MMM yyyy")</td>
                        <td>@(row.DaysAway == 0 ? "Today" : $"in {row.DaysAway} days")</td>
                        <td><span class="badge bg-dark">@row.EnrolmentCount</span></td>
                        <td class="text-end">
                            <a asp-action="Enrolments" asp-route-eventId="@row.Event.EventID" class="btn btn-sm btn-outline-secondary">Enrolments</a>
                            <a asp-action="Categories" asp-route-eventId="@row.Event.EventID" class="btn btn-sm btn-outline-secondary">Categories</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<h2 class="h4">Latest enrolments</h2>
@if (!Model.RecentEnrolments.Any())
{
    <div class="alert alert-light border">No one has entered your events yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle bg-white">
            <thead class="table-light">
                <tr><th>Participant</th><th>Event</th><th>Category</th><th>Status</th></tr>
            </thead>
            <tbody>
                @foreach (var e in Model.RecentEnrolments)
                {
                    <tr>
                        <td>@e.ParticipantName</td>
                        <td>@e.EventName</td>
                        <td>@e.CategoryName</td>
                        <td><span class="badge @Badge(e.PaymentStatus)">@e.PaymentStatus</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}