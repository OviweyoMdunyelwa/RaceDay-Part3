@model List<RaceDay.MVC.Models.DashboardEventRowVm>
@using RaceDay.MVC.Services
@{
    ViewData["Title"] = "My events";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">My events</h1>
    <a asp-action="CreateEvent" class="btn btn-accent">+ New event</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">You have not created any events yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle bg-white">
            <thead class="table-light">
                <tr>
                    <th>Banner</th>
                    <th>Event</th>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Distance</th>
                    <th>Status</th>
                    <th>Enrolments</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model)
                {
                    var img = ImageUrl.Proxy(row.Event.BannerImageUrl);
                    <tr>
                        <td style="width:110px">
                            @if (img != null)
                            {
                                <img src="@img" alt="Banner" class="rounded" style="width:100px;height:60px;object-fit:cover;" />
                            }
                            else
                            {
                                <span class="text-muted small">No banner</span>
                            }
                        </td>
                        <td>
                            <strong>@row.Event.EventName</strong><br />
                            <small class="text-muted">@row.Event.Location</small>
                        </td>
                        <td>@row.Event.EventDate.ToString("dd MMM yyyy")</td>
                        <td>@row.Event.EventType</td>
                        <td>@row.Event.DistanceKM.ToString("0.##") km</td>
                        <td><span class="badge bg-secondary">@row.Event.Status</span></td>
                        <td><span class="badge bg-dark">@row.EnrolmentCount</span></td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Categories" asp-route-eventId="@row.Event.EventID" class="btn btn-sm btn-outline-secondary">Categories</a>
                            <a asp-action="Enrolments" asp-route-eventId="@row.Event.EventID" class="btn btn-sm btn-outline-secondary">Enrolments</a>
                            <a asp-controller="Banner" asp-action="Upload" asp-route-id="@row.Event.EventID" class="btn btn-sm btn-accent">Banner</a>
                            <a asp-action="EditEvent" asp-route-id="@row.Event.EventID" class="btn btn-sm btn-raceday">Edit</a>
                            <form asp-action="DeleteEvent" asp-route-id="@row.Event.EventID" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this event?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}