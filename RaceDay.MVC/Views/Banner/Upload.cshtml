@model RaceDay.MVC.Models.EventDto
@{
    ViewData["Title"] = "Event banner";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <h1 class="mb-1">Event banner</h1>
        <p class="text-muted">@Model.EventName</p>

        <div class="card mb-4">
            <partial name="_EventBanner" model="Model" />
        </div>

        <form asp-controller="Banner" asp-action="Upload" asp-route-id="@Model.EventID"
              method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <label class="form-label">Choose a picture (JPG, PNG, GIF or WEBP, up to 5 MB)</label>
                <input type="file" name="banner" accept="image/*" class="form-control" />
            </div>
            <button type="submit" class="btn btn-raceday">Upload banner</button>
            <a asp-controller="Organiser" asp-action="Events" class="btn btn-link">Back to events</a>
        </form>
    </div>
</div>